# npm reads these keys from 11.16 on (Node 24.22.2, .nvmrc) and ignores the
# ones it doesn't know, so an older npm silently skips them. Re-check them
# when npm 12 lands: it changes the install-script defaults.
engine-strict=true
# Refuse any version published less than 7 days ago (the same cooldown as
# Dependabot). To bypass it for one deliberate install, pass a release age of
# zero on that npm install command line (AGENTS.md, Supply-chain controls).
min-release-age=7
# Registry packages only: no git or tarball-URL dependencies.
allow-git=none
allow-remote=none
# A dependency with an install script not listed in package.json allowScripts
# fails the install. Don't add ignore-scripts: it breaks npm approve-scripts.
strict-allow-scripts=true
